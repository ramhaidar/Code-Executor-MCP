    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./build",
    "rootDir": "./",
    "skipLibCheck": true,
    "declaration": true
  },
  "include": [
    "src/**/*",
    "scenarios/**/*"
  ]
}