{
  "name": "code-executor-mcp",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "code-executor-mcp": "./build/server.js"
  },
  "resolutions": {
    "hono": "4.11.7"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.14.1",
      "hono": ">=4.11.7"
    }
  },
  "scripts": {
    "gen": "tsx src/generate.ts",
